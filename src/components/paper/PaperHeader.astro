---
interface Props {
  frontmatter: {
    title: string;
    subtitle?: string;
    description: string;
    authors: string[];
    paperYear: number;
    annotator: string;
    publishedDate: Date;
    updatedDate?: Date;
    arxivId?: string;
    doi?: string;
    venue?: string;
    readingTimeMinutes?: number;
    chapterCount?: number;
    codeSnippetCount?: number;
    interactiveCount?: number;
    tags?: string[];
    referenceRepo?: { url: string; commit: string };
  };
  chapterCount: number;
}

const { frontmatter, chapterCount } = Astro.props;
const published = frontmatter.publishedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updated = frontmatter.updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const shortCommit = frontmatter.referenceRepo?.commit?.slice(0, 7);
const originalPaperUrl = frontmatter.doi
  ? `https://doi.org/${frontmatter.doi}`
  : frontmatter.arxivId
    ? `https://arxiv.org/abs/${frontmatter.arxivId}`
    : undefined;
const sourceIdentifier = frontmatter.doi
  ? `DOI ${frontmatter.doi}`
  : frontmatter.arxivId
    ? `arXiv ${frontmatter.arxivId}`
    : undefined;
---

<header class="paper-header">
  <a class="paper-breadcrumb" href="/">Papers</a>

  <div class="paper-kicker-row">
    <p>Paper annotation</p>
    <p>{frontmatter.venue ? `${frontmatter.venue} · ` : ''}{frontmatter.paperYear}</p>
  </div>

  <h1>{frontmatter.title}</h1>
  <p class="paper-summary">{frontmatter.subtitle ?? frontmatter.description}</p>

  <p class="paper-source">
    <span>Source</span>
    {frontmatter.authors.join(', ')} ({frontmatter.paperYear}){frontmatter.venue ? `, ${frontmatter.venue}` : ''}.
    {sourceIdentifier && <> {sourceIdentifier}.</>}
  </p>

  <nav class="paper-links" aria-label="Paper resources">
    {originalPaperUrl && (
      <a href={originalPaperUrl} target="_blank" rel="noopener">Original paper <span aria-hidden="true">↗</span></a>
    )}
    {frontmatter.referenceRepo && (
      <a href={`${frontmatter.referenceRepo.url}/tree/${frontmatter.referenceRepo.commit}`} target="_blank" rel="noopener">
        Reference implementation <span aria-hidden="true">↗</span>
      </a>
    )}
  </nav>

  <dl class="paper-stats" aria-label="Annotation statistics">
    {frontmatter.readingTimeMinutes && <div><dt>Reading time</dt><dd>{frontmatter.readingTimeMinutes} min</dd></div>}
    <div><dt>Chapters</dt><dd>{frontmatter.chapterCount ?? chapterCount}</dd></div>
    {frontmatter.codeSnippetCount && <div><dt>Code excerpts</dt><dd>{frontmatter.codeSnippetCount}</dd></div>}
    {frontmatter.interactiveCount && <div><dt>Interactive figures</dt><dd>{frontmatter.interactiveCount}</dd></div>}
  </dl>

  <nav class="contents-overview" aria-labelledby="contents-overview-title">
    <h2 id="contents-overview-title">Contents overview</h2>
    <ol>
      <li><a href="#0-prelims"><span>01</span><strong>Foundations</strong><small>Sections 0–1</small></a></li>
      <li><a href="#2-input-representations"><span>02</span><strong>Representations</strong><small>Sections 2–9</small></a></li>
      <li><a href="#10-the-structure-module"><span>03</span><strong>Structure and loss</strong><small>Sections 10–12</small></a></li>
      <li><a href="#13-training"><span>04</span><strong>Training and limitations</strong><small>Sections 13–15</small></a></li>
    </ol>
  </nav>

  <div class="paper-provenance">
    <span>Annotation published {published}{updated && updated !== published && <> · Updated {updated}</>}</span>
    <span>Annotated by <a href="https://chrishayduk.com" rel="me author">{frontmatter.annotator}</a></span>
    {shortCommit && <span>Reference commit <code>{shortCommit}</code></span>}
  </div>
</header>

<style>
  .paper-header {
    margin-bottom: 3.75rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--rule);
  }

  .paper-breadcrumb {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: var(--fg-muted);
    font: 500 0.7rem/1.2 var(--font-sans);
    text-decoration: none;
  }

  .paper-breadcrumb::before {
    margin-right: 0.4rem;
    content: "←";
  }

  .paper-breadcrumb:hover { color: var(--fg); }

  .paper-kicker-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
    color: var(--fg-muted);
    font: 600 0.66rem/1.3 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .paper-kicker-row p { margin: 0; }

  .paper-header h1 {
    max-width: 16ch;
    margin: 0;
    color: var(--fg);
    font-size: clamp(2.7rem, 5vw, 4.35rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    text-wrap: balance;
  }

  .paper-summary {
    max-width: 58ch;
    margin: 1.25rem 0 0;
    color: var(--fg-muted);
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.55;
  }

  .paper-source {
    max-width: 72ch;
    margin: 1.25rem 0 0;
    color: var(--fg-muted);
    font: 400 0.76rem/1.6 var(--font-sans);
  }

  .paper-source > span {
    margin-right: 0.45rem;
    color: var(--fg);
    font-weight: 600;
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.4rem;
    font-family: var(--font-sans);
  }

  .paper-links a {
    color: var(--fg);
    font-size: 0.75rem;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .paper-links a:hover { color: var(--accent); }

  .paper-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 2.25rem 0 0;
    border-block: 1px solid var(--rule);
  }

  .paper-stats > div {
    min-width: 0;
    padding: 0.9rem 0.9rem 0.9rem 0;
  }

  .paper-stats > div + div {
    padding-left: 0.9rem;
    border-left: 1px solid var(--rule);
  }

  .paper-stats dt {
    color: var(--fg-muted);
    font: 500 0.61rem/1.3 var(--font-sans);
  }

  .paper-stats dd {
    margin: 0.25rem 0 0;
    color: var(--fg);
    font: 500 1.1rem/1.15 var(--font-serif);
    font-variant-numeric: tabular-nums;
  }

  .contents-overview { margin-top: 2.25rem; }

  .contents-overview h2 {
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
    color: var(--fg);
    font: 600 0.72rem/1.3 var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contents-overview ol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .contents-overview li {
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }

  .contents-overview li:nth-child(odd) { border-right: 1px solid var(--rule); }

  .contents-overview a {
    min-height: 3.6rem;
    padding: 0.75rem 0.8rem;
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-family: var(--font-sans);
    text-decoration: none;
  }

  .contents-overview a:hover { background: var(--surface); }

  .contents-overview a > span {
    color: var(--fg-muted);
    font: 500 0.61rem/1 var(--font-mono);
  }

  .contents-overview strong {
    font-size: 0.73rem;
    font-weight: 600;
  }

  .contents-overview small {
    color: var(--fg-muted);
    font-size: 0.62rem;
  }

  .paper-provenance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 1.1rem;
    color: var(--fg-muted);
    font: 400 0.62rem/1.5 var(--font-sans);
  }

  .paper-provenance a { color: inherit; }
  .paper-provenance code { color: var(--fg); font-size: 0.95em; }

  @media (max-width: 680px) {
    .paper-header { margin-bottom: 3rem; padding-bottom: 2.5rem; }
    .paper-breadcrumb { margin-bottom: 2rem; }
    .paper-kicker-row { align-items: flex-start; flex-direction: column; gap: 0.3rem; }
    .paper-header h1 { font-size: clamp(2.55rem, 13vw, 3.4rem); }
    .paper-links { align-items: flex-start; flex-direction: column; }
    .paper-stats { grid-template-columns: 1fr 1fr; }
    .paper-stats > div:nth-child(3) { border-left: 0; }
    .paper-stats > div:nth-child(n + 3) { border-top: 1px solid var(--rule); }
    .contents-overview ol { grid-template-columns: 1fr; }
    .contents-overview li:nth-child(odd) { border-right: 0; }
    .contents-overview a { grid-template-columns: 1.7rem minmax(0, 1fr); }
    .contents-overview small { grid-column: 2; }
  }
</style>
