---
interface Props {
  frontmatter: {
    title: string;
    subtitle?: string;
    authors: string[];
    paperYear: number;
    annotator: string;
    publishedDate: Date;
    updatedDate?: Date;
    arxivId?: string;
    doi?: string;
    venue?: string;
    readingTimeMinutes?: number;
    chapterCount?: number;
    codeSnippetCount?: number;
    interactiveCount?: number;
    tags?: string[];
    referenceRepo?: { url: string; commit: string };
  };
  chapterCount: number;
}

const { frontmatter, chapterCount } = Astro.props;
const published = frontmatter.publishedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updated = frontmatter.updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const shortCommit = frontmatter.referenceRepo?.commit?.slice(0, 7);
const originalPaperUrl = frontmatter.doi
  ? `https://doi.org/${frontmatter.doi}`
  : frontmatter.arxivId
    ? `https://arxiv.org/abs/${frontmatter.arxivId}`
    : undefined;
---

<header class="paper-header">
  <a class="paper-breadcrumb" href="/">Annotated Papers <span>／ Volume 01</span></a>

  <div class="paper-kicker-row">
    <p class="eyebrow">Guided implementation walkthrough</p>
    {frontmatter.venue && <p class="paper-venue">{frontmatter.venue} · {frontmatter.paperYear}</p>}
  </div>

  <h1>{frontmatter.title}</h1>
  {frontmatter.subtitle && <p class="paper-subtitle">{frontmatter.subtitle}</p>}

  <p class="paper-citation">
    Based on {frontmatter.authors.join(', ')} ({frontmatter.paperYear}).
    Annotated by <a href="https://chrishayduk.com" rel="me author" target="_blank">{frontmatter.annotator}</a>.
  </p>

  <div class="paper-action-row">
    <a class="button-primary" href="#0-prelims">Begin the full read <span aria-hidden="true">↓</span></a>
    {originalPaperUrl && (
      <a class="button-secondary" href={originalPaperUrl} target="_blank" rel="noopener">Original paper ↗</a>
    )}
    {frontmatter.referenceRepo && (
      <a class="button-secondary" href={`${frontmatter.referenceRepo.url}/tree/${frontmatter.referenceRepo.commit}`} target="_blank" rel="noopener">
        Reference code ↗
      </a>
    )}
  </div>

  <div class="paper-ledger" aria-label="Guide statistics">
    {frontmatter.readingTimeMinutes && <div><strong>{frontmatter.readingTimeMinutes}</strong><span>minute guided read</span></div>}
    <div><strong>{frontmatter.chapterCount ?? chapterCount}</strong><span>chapters</span></div>
    {frontmatter.codeSnippetCount && <div><strong>{frontmatter.codeSnippetCount}</strong><span>pinned code excerpts</span></div>}
    {frontmatter.interactiveCount && <div><strong>{frontmatter.interactiveCount}</strong><span>interactive labs</span></div>}
  </div>

  <section class="reader-briefing" aria-labelledby="reader-briefing-title">
    <div class="reader-briefing-copy">
      <p class="eyebrow">Reader briefing</p>
      <h2 id="reader-briefing-title">From biological intuition to executable architecture.</h2>
      <p>
        Follow the ideas from protein folding and evolutionary signal through the
        Evoformer, Invariant Point Attention, FAPE, training, and a real overfit run.
        The biology is introduced from first principles; basic deep-learning notation helps.
      </p>
    </div>
    <ol class="reading-map" aria-label="Four-part reading map">
      <li><a href="#0-prelims"><span>01</span><strong>Foundations</strong><small>§§0–1 · biology and the problem</small></a></li>
      <li><a href="#2-input-representations"><span>02</span><strong>Representations</strong><small>§§2–9 · MSA, pair stack, Evoformer</small></a></li>
      <li><a href="#10-the-structure-module"><span>03</span><strong>Geometry & loss</strong><small>§§10–12 · frames, IPA, FAPE</small></a></li>
      <li><a href="#13-training"><span>04</span><strong>Training & limits</strong><small>§§13–15 · runnable proof and gaps</small></a></li>
    </ol>
  </section>

  <div class="paper-provenance">
    <span>Published {published}{updated && updated !== published && <> · Updated {updated}</>}</span>
    {frontmatter.doi && <a href={`https://doi.org/${frontmatter.doi}`} target="_blank" rel="noopener">doi:{frontmatter.doi}</a>}
    {shortCommit && <span>Source pinned at <code>{shortCommit}</code></span>}
  </div>
</header>

<style>
  .paper-header {
    margin-bottom: 4.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .paper-breadcrumb {
    display: inline-flex;
    margin-bottom: 3rem;
    color: var(--fg-muted);
    font: 600 0.68rem/1.2 var(--font-sans);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .paper-breadcrumb span { color: var(--fg-faint); }
  .paper-breadcrumb:hover { color: var(--accent); }

  .paper-kicker-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .paper-venue {
    margin: 0;
    color: var(--fg-faint);
    font: 600 0.68rem/1.2 var(--font-sans);
  }

  .paper-header h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--fg);
    font-size: clamp(3.2rem, 6.2vw, 5.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .paper-subtitle {
    max-width: 53ch;
    margin: 1.35rem 0 0;
    color: var(--fg-muted);
    font-size: clamp(1.15rem, 2vw, 1.42rem);
    font-style: normal;
    line-height: 1.45;
    text-wrap: balance;
  }

  .paper-citation {
    margin: 1.2rem 0 0;
    color: var(--fg-muted);
    font: 400 0.8rem/1.55 var(--font-sans);
  }

  .paper-action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .paper-ledger {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 2.25rem;
    border-block: 1px solid var(--rule);
  }

  .paper-ledger > div {
    min-width: 0;
    padding: 1.05rem 1rem 1rem 0;
    display: grid;
    gap: 0.2rem;
  }

  .paper-ledger > div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .paper-ledger strong {
    color: var(--fg);
    font: 500 1.45rem/1 var(--font-serif);
    font-variant-numeric: tabular-nums;
  }

  .paper-ledger span {
    color: var(--fg-muted);
    font: 600 0.62rem/1.25 var(--font-sans);
  }

  .reader-briefing {
    margin-top: 2.5rem;
    padding: clamp(1.3rem, 3vw, 2rem);
    border: 1px solid var(--rule);
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--accent-soft) 55%, transparent), transparent 50%),
      var(--surface);
  }

  .reader-briefing-copy h2 {
    max-width: 22ch;
    margin: 0.55rem 0 0;
    padding: 0;
    border: 0;
    color: var(--fg);
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .reader-briefing-copy > p:last-child {
    max-width: 62ch;
    margin: 0.9rem 0 0;
    color: var(--fg-muted);
    font: 400 0.82rem/1.65 var(--font-sans);
  }

  .reading-map {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin: 1.6rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .reading-map li { margin: 0; }
  .reading-map li:nth-child(odd) { border-right: 1px solid var(--rule); }
  .reading-map li:nth-child(-n + 2) { border-bottom: 1px solid var(--rule); }
  .reading-map a {
    min-height: 5.5rem;
    padding: 1rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.12rem 0.7rem;
    align-content: center;
    color: var(--fg);
    font-family: var(--font-sans);
    text-decoration: none;
    transition: background 140ms ease;
  }
  .reading-map a:hover { background: color-mix(in oklab, var(--surface-strong) 70%, transparent); }
  .reading-map span {
    grid-row: 1 / 3;
    color: var(--accent);
    font: 700 0.66rem/1.4 var(--font-mono);
  }
  .reading-map strong { font-size: 0.76rem; }
  .reading-map small { color: var(--fg-muted); font-size: 0.65rem; line-height: 1.35; }

  .paper-provenance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 1.2rem;
    color: var(--fg-faint);
    font: 400 0.62rem/1.5 var(--font-sans);
  }
  .paper-provenance a { color: inherit; }
  .paper-provenance code { color: var(--fg-muted); font-size: 0.95em; }

  @media (max-width: 680px) {
    .paper-header { margin-bottom: 3.25rem; padding-bottom: 2.5rem; }
    .paper-breadcrumb { margin-bottom: 2.25rem; }
    .paper-kicker-row { align-items: flex-start; flex-direction: column; gap: 0.4rem; }
    .paper-header h1 { font-size: clamp(3rem, 16vw, 4.25rem); }
    .paper-action-row :global(a) { width: 100%; }
    .paper-ledger { grid-template-columns: 1fr 1fr; }
    .paper-ledger > div:nth-child(3) { border-left: 0; }
    .paper-ledger > div:nth-child(n + 3) { border-top: 1px solid var(--rule); }
    .reading-map { grid-template-columns: 1fr; }
    .reading-map li:nth-child(odd) { border-right: 0; }
    .reading-map li:not(:last-child) { border-bottom: 1px solid var(--rule); }
  }
</style>
