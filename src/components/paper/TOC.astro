---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

interface Chapter {
  heading: Heading;
  children: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const chapters: Chapter[] = [];

for (const heading of items) {
  if (heading.depth === 2) {
    chapters.push({ heading, children: [] });
  } else if (chapters.length > 0) {
    chapters[chapters.length - 1].children.push(heading);
  }
}
---

{chapters.length > 0 && (
  <nav class="toc" aria-label="Table of contents">
    <p class="toc-title">Chapters</p>
    <ol class="toc-chapters">
      {chapters.map((chapter) => (
        <li class="toc-chapter" data-chapter-id={chapter.heading.slug}>
          <a class="toc-chapter-link" href={`#${chapter.heading.slug}`} data-toc-link={chapter.heading.slug}>
            <span class="toc-number">{chapter.heading.text.match(/^(?:§\s*)?([\d]+|\d+[a-z])(?:\.|\s)/i)?.[1] ?? '•'}</span>
            <span>{chapter.heading.text.replace(/^\d+[a-z]?\.\s*/i, '').replace(/^\d+[a-z]?\s+/i, '')}</span>
          </a>
          {chapter.children.length > 0 && (
            <ol class="toc-subsections">
              {chapter.children.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
                </li>
              ))}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  function initScrollspy() {
    if (document.documentElement.dataset.paperTocReady === 'true') return;
    document.documentElement.dataset.paperTocReady = 'true';
    const tocs = Array.from(document.querySelectorAll<HTMLElement>('.toc'));
    if (tocs.length === 0) return;

    const allLinks = tocs.flatMap((toc) => Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]')));
    const linkById = new Map<string, HTMLAnchorElement[]>();
    const headingOrder: string[] = [];

    for (const link of allLinks) {
      const id = link.dataset.tocLink;
      if (!id) continue;
      const matches = linkById.get(id) ?? [];
      matches.push(link);
      linkById.set(id, matches);
      if (!headingOrder.includes(id)) headingOrder.push(id);
    }

    const sectionHeadings = headingOrder
      .map((id) => document.getElementById(id))
      .filter((element): element is HTMLElement => element !== null);
    if (sectionHeadings.length === 0) return;

    let activeId: string | null = null;
    let lockedUntil = 0;
    const CLICK_LOCK_MS = 700;

    function scrollLinkIntoView(link: HTMLAnchorElement) {
      const container = link.closest<HTMLElement>('.paper-toc-column, .mobile-toc-panel');
      if (!container || container.classList.contains('mobile-toc-panel')) return;
      const containerRect = container.getBoundingClientRect();
      const linkRect = link.getBoundingClientRect();
      if (linkRect.top > containerRect.top + 56 && linkRect.bottom < containerRect.bottom - 56) return;
      const top = linkRect.top - containerRect.top + container.scrollTop - container.clientHeight / 3;
      container.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }

    function setActive(id: string) {
      if (id === activeId) return;
      activeId = id;

      for (const toc of tocs) {
        toc.querySelectorAll('.toc-active').forEach((node) => node.classList.remove('toc-active'));
        toc.querySelectorAll('.toc-chapter--active').forEach((node) => node.classList.remove('toc-chapter--active'));
      }

      const links = linkById.get(id) ?? [];
      for (const link of links) {
        link.classList.add('toc-active');
        link.setAttribute('aria-current', 'location');
        link.closest('.toc-chapter')?.classList.add('toc-chapter--active');
        scrollLinkIntoView(link);
      }

      for (const link of allLinks) {
        if (link.dataset.tocLink !== id) link.removeAttribute('aria-current');
      }

      const heading = document.getElementById(id);
      const text = heading?.textContent?.replace(/#$/, '').trim() ?? links[0]?.textContent?.trim() ?? (id || 'Paper overview');
      document.dispatchEvent(new CustomEvent('paper-section-change', { detail: { id, text } }));
    }

    function chooseCurrentHeading() {
      if (performance.now() < lockedUntil) return;
      // The active heading should include a newly reached fragment target,
      // which sits below the global header, mobile dock, and reading margin.
      const headerHeight = document.querySelector('.site-nav')?.getBoundingClientRect().height ?? 80;
      const dockHeight = window.innerWidth < 1024
        ? document.querySelector('.mobile-reader-dock summary')?.getBoundingClientRect().height ?? 60
        : 0;
      const offset = Math.max(headerHeight + dockHeight + 48, window.innerHeight * 0.18);
      let current: HTMLElement | undefined;
      for (const heading of sectionHeadings) {
        if (heading.getBoundingClientRect().top <= offset) current = heading;
        else break;
      }
      setActive(current?.id ?? '');
    }

    let scrollQueued = false;
    const schedule = () => {
      if (scrollQueued) return;
      scrollQueued = true;
      requestAnimationFrame(() => {
        scrollQueued = false;
        chooseCurrentHeading();
      });
    };

    for (const link of allLinks) {
      link.addEventListener('click', () => {
        const id = link.dataset.tocLink;
        if (!id) return;
        lockedUntil = performance.now() + CLICK_LOCK_MS;
        setActive(id);
      });
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    chooseCurrentHeading();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollspy, { once: true });
  } else {
    initScrollspy();
  }
</script>

<style>
  .toc {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .toc-title {
    margin: 0 0 0.6rem;
    color: var(--fg-faint);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-chapter { margin: 0.2rem 0; border-radius: 0.4rem; }
  .toc-chapter--active { background: var(--accent-soft); }

  .toc a {
    display: block;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .toc-chapter-link {
    min-height: 2.7rem;
    padding: 0.65rem 0.6rem;
    border-radius: 0.35rem;
    display: grid !important;
    grid-template-columns: 1.55rem minmax(0, 1fr);
    align-items: center;
    gap: 0.25rem;
    font-weight: 600;
  }

  .toc-number {
    color: var(--fg-faint);
    font: 600 0.6rem/1 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .toc a:hover,
  .toc a:focus-visible { color: var(--accent); background: var(--surface); }

  .toc-chapter--active > .toc-chapter-link,
  .toc a.toc-active {
    color: var(--accent);
  }

  .toc-chapter--active > .toc-chapter-link .toc-number { color: var(--accent); }

  .toc-subsections {
    display: none;
    padding: 0 0 0.7rem 2rem !important;
  }

  .toc-chapter--active .toc-subsections,
  .toc-chapter:focus-within .toc-subsections { display: block; }

  .toc-subsections a {
    position: relative;
    padding: 0.35rem 0.6rem 0.35rem 0.7rem;
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .toc-subsections a::before {
    content: "";
    position: absolute;
    top: 0.9rem;
    left: 0;
    width: 0.25rem;
    height: 1px;
    background: var(--rule-strong);
  }

  .toc-subsections a.toc-active {
    font-weight: 700;
  }

  .toc-subsections a.toc-active::before {
    width: 0.4rem;
    background: var(--accent);
  }

  :global(.mobile-toc-panel) .toc-subsections { display: block; }
  :global(.mobile-toc-panel) .toc-title { display: none; }
  :global(.mobile-toc-panel) .toc-chapter-link { min-height: 2.8rem; }
  :global(.mobile-toc-panel) .toc-subsections a { min-height: 2.25rem; padding-block: 0.5rem; }
</style>
