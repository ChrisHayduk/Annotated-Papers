---
// One block, split into the MSA updates and the pair updates. Numbering
// establishes execution order; the two colored cross-lane arrows show where
// information moves between representations. Residual additions are implicit.
const msaSteps = [
  { x: 145, number: '1', lines: ['Row attention'], note: 'across residues' },
  { x: 335, number: '2', lines: ['Column attention'], note: 'across sequences' },
  { x: 525, number: '3', lines: ['MSA transition'], note: 'per-position MLP' },
];
const pairSteps = [
  { x: 145, number: '4', lines: ['Outer product', 'mean'], note: 'MSA → pair update' },
  { x: 335, number: '5', lines: ['Triangle', 'multiplication'], note: 'outgoing + incoming' },
  { x: 525, number: '6', lines: ['Triangle', 'attention'], note: 'starting + ending' },
  { x: 715, number: '7', lines: ['Pair transition'], note: 'per-pair MLP' },
];
---
<figure class="evo-fig" aria-labelledby="evo-title">
  <header class="evo-heading">
    <span class="evo-kicker">INSIDE THE EVOFORMER</span>
    <h4 id="evo-title">The seven updates inside one Evoformer block</h4>
    <p>Follow steps 1–3 across the MSA lane, then steps 4–7 across the pair lane.</p>
  </header>
  <p class="evo-scroll-hint">Scroll horizontally to follow all seven steps →</p>
  <div class="evo-scroll" role="region" aria-label="Scrollable diagram of one Evoformer block" tabindex="0">
    <svg viewBox="0 0 1000 450" role="img" aria-labelledby="evo-svg-title evo-svg-description">
      <title id="evo-svg-title">The MSA and pair update paths inside one Evoformer block</title>
      <desc id="evo-svg-description">MSA m passes through row attention, column attention, and an MSA transition, then continues to the next block. Pair z biases row attention. The updated MSA passes through outer product mean, which adds an update to z. Pair z then passes through triangle multiplication, triangle attention, and a pair transition before the next block. These are the two cross-stream connections.</desc>
      <defs>
        <marker id="evo-msa-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10Z" fill="var(--data-msa)" /></marker>
        <marker id="evo-pair-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10Z" fill="var(--data-pair)" /></marker>
      </defs>
      <rect class="evo-lane-bg evo-msa" x="10" y="68" width="980" height="120" rx="9" />
      <rect class="evo-lane-bg evo-pair" x="10" y="301" width="980" height="120" rx="9" />
      <text class="evo-lane-label evo-msa" x="22" y="52">MSA representation m</text>
      <text class="evo-lane-label evo-pair" x="335" y="295">Pair representation z</text>
      <text class="evo-endpoint evo-msa" x="28" y="118">m in</text>
      <text class="evo-endpoint evo-pair" x="28" y="344">z in</text>

      <g class="evo-flow evo-msa" marker-end="url(#evo-msa-arrow)">
        <path d="M78 130 H140" /><path d="M305 130 H330" /><path d="M495 130 H520" /><path d="M685 130 H933" />
      </g>
      <g class="evo-flow evo-pair" marker-end="url(#evo-pair-arrow)">
        <path d="M78 356 H140" /><path d="M305 356 H330" /><path d="M495 356 H520" /><path d="M685 356 H710" /><path d="M875 356 H933" />
      </g>
      <text class="evo-endpoint evo-msa" x="855" y="117">m to next block</text>
      <text class="evo-endpoint evo-pair" x="845" y="441">z to next block</text>

      {msaSteps.map((step) => <g class="evo-block evo-msa">
        <rect x={step.x} y="87" width="160" height="86" rx="6" />
        <text class="evo-number" x={step.x + 13} y="107">{step.number}</text>
        <text x={step.x + 80} y="133" text-anchor="middle">{step.lines[0]}</text>
        <text class="evo-sub" x={step.x + 80} y="155" text-anchor="middle">{step.note}</text>
      </g>)}
      {pairSteps.map((step) => <g class="evo-block evo-pair">
        <rect x={step.x} y="313" width="160" height="96" rx="6" />
        <text class="evo-number" x={step.x + 13} y="333">{step.number}</text>
        {step.lines.map((line, index) => <text x={step.x + 80} y={step.lines.length === 1 ? 362 : 351 + index * 18} text-anchor="middle">{line}</text>)}
        <text class="evo-sub" x={step.x + 80} y="393" text-anchor="middle">{step.note}</text>
      </g>)}

      <circle class="evo-dot evo-pair" cx="111" cy="356" r="3.5" />
      <path class="evo-cross evo-pair" d="M111 356 V210 H225 V178" marker-end="url(#evo-pair-arrow)" />
      <text class="evo-cross-label evo-pair" x="246" y="215">Pair features bias row attention in step 1</text>

      <circle class="evo-dot evo-msa" cx="710" cy="130" r="3.5" />
      <path class="evo-cross evo-msa" d="M710 130 V244 H225 V308" marker-end="url(#evo-msa-arrow)" />
      <text class="evo-cross-label evo-msa" x="246" y="267">Updated MSA from step 3 supplies step 4</text>
    </svg>
  </div>
  <figcaption>
    <strong>The two connections to trace:</strong> <i>z</i> supplies the bias used in MSA row attention;
    the outer product mean turns the updated <i>m</i> into an update added to <i>z</i>.
    Every operation adds its result to its own stream; the diagram omits these residual additions for clarity.
    The resulting <i>m</i> and <i>z</i> enter the next block. The full Evoformer has 48 blocks.
  </figcaption>
</figure>

<style>
  .evo-fig { margin: 1.75rem 0; padding: 1.35rem; border: 1px solid var(--rule-strong); border-radius: .7rem; background: var(--surface-strong); font-family: var(--font-sans); }
  .evo-kicker { color: var(--accent); font: 600 .65rem var(--font-mono); letter-spacing: .1em; }
  .evo-heading h4 { margin: .4rem 0 .35rem; color: var(--fg); font-size: 1.05rem; line-height: 1.45; }
  .evo-heading p { margin: 0; color: var(--fg-muted); font-size: .8rem; line-height: 1.6; }
  .evo-scroll { overflow-x: auto; overscroll-behavior-x: contain; margin: .3rem 0 .7rem; border-radius: .3rem; }
  .evo-scroll:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .evo-scroll-hint { display: none; margin: .75rem 0 0; color: var(--accent); font-size: .73rem; }
  .evo-fig svg { display: block; width: 100%; min-width: 780px; height: auto; font-family: var(--font-sans); }
  .evo-msa { --stream: var(--data-msa); }
  .evo-pair { --stream: var(--data-pair); }
  .evo-lane-bg { fill: color-mix(in oklab, var(--stream) 5%, var(--bg)); }
  .evo-lane-label { fill: var(--stream); font-size: 16px; font-weight: 600; }
  .evo-endpoint { fill: var(--stream); font: 12px var(--font-mono); }
  .evo-flow, .evo-cross { stroke: var(--stream); stroke-width: 1.8; fill: none; }
  .evo-cross { stroke-width: 2; stroke-linejoin: round; }
  .evo-dot { fill: var(--stream); }
  .evo-cross-label { fill: var(--stream); font-size: 13px; }
  .evo-block rect { fill: var(--surface-strong); stroke: color-mix(in oklab, var(--stream) 58%, var(--rule)); stroke-width: 1.2; }
  .evo-block text { fill: var(--fg); font-size: 14px; font-weight: 600; }
  .evo-block .evo-number { fill: var(--stream); font: 600 12px var(--font-mono); }
  .evo-block .evo-sub { fill: var(--fg-muted); font-size: 11px; font-weight: 400; }
  .evo-fig figcaption { margin: 0; padding-top: .9rem; border-top: 1px solid var(--rule); font-size: .76rem; color: var(--fg-muted); line-height: 1.65; }
  .evo-fig figcaption strong { color: var(--fg); }
  @media (max-width: 940px) { .evo-scroll-hint { display: block; } }
  @media (max-width: 520px) { .evo-fig { padding: 1rem .8rem; } }
</style>
