---
interface Props {
  label?: string;
}

const { label = 'Editorial note' } = Astro.props;
---

<aside class="editorial-note" aria-label={label}>
  <div class="editorial-note-label">
    <span class="editorial-note-rule" aria-hidden="true"></span>
    {label}
  </div>
  <div class="editorial-note-body">
    <slot />
  </div>
</aside>

<style>
  .editorial-note {
    position: relative;
    margin: 1.75rem 0;
    padding: 1.15rem 1.25rem 1.2rem;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--accent) 22%, var(--rule));
    border-radius: 0.75rem;
    background:
      linear-gradient(115deg, color-mix(in oklab, var(--accent-soft, var(--accent)) 34%, transparent), transparent 62%),
      var(--surface, color-mix(in oklab, var(--bg) 96%, var(--fg) 4%));
    color: var(--fg);
    box-shadow: 0 0.75rem 2.2rem color-mix(in oklab, var(--fg) 5%, transparent);
    font-style: normal;
  }

  .editorial-note::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.22rem;
    background: linear-gradient(to bottom, var(--accent), color-mix(in oklab, var(--accent) 20%, transparent));
    content: '';
  }

  .editorial-note-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .editorial-note-rule {
    width: 1.4rem;
    height: 1px;
    background: currentColor;
    opacity: 0.75;
  }

  .editorial-note-body {
    color: color-mix(in oklab, var(--fg) 88%, var(--fg-muted));
  }

  :global(.editorial-note-body > :first-child) { margin-top: 0; }
  :global(.editorial-note-body > :last-child) { margin-bottom: 0; }

  @media (max-width: 640px) {
    .editorial-note {
      margin-inline: -0.2rem;
      padding: 1rem 1rem 1.05rem;
      border-radius: 0.65rem;
    }
  }
</style>
