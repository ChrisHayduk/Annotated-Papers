---
interface Props {
  label?: string;
}

const { label = 'Note' } = Astro.props;
---

<aside class="editorial-note" aria-label={label}>
  <div class="editorial-note-label">
    {label}
  </div>
  <div class="editorial-note-body">
    <slot />
  </div>
</aside>

<style>
  .editorial-note {
    margin: 1.5rem 0;
    padding: 0.95rem 1rem;
    border-left: 2px solid var(--accent);
    background: var(--surface, color-mix(in oklab, var(--rule) 22%, transparent));
    color: var(--fg);
    font-style: normal;
  }

  .editorial-note-label {
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .editorial-note-body {
    color: color-mix(in oklab, var(--fg) 90%, var(--fg-muted));
  }

  :global(.editorial-note-body > :first-child) { margin-top: 0; }
  :global(.editorial-note-body > :last-child) { margin-bottom: 0; }

  @media (max-width: 640px) {
    .editorial-note {
      margin-inline: 0;
      padding: 0.85rem 0.9rem;
    }
  }
</style>
