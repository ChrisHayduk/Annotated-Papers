---
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  id?: string;
  number?: number;
}
const { src, alt, caption, id, number } = Astro.props;
---

<figure class="paper-figure" id={id}>
  <div class="figure-stage">
    {src && <img class="figure-image" src={src} alt={alt ?? ''} loading="lazy" decoding="async" />}
    <slot />
  </div>
  {caption && (
    <figcaption>
      <strong>Figure{number !== undefined && ` ${number}`}</strong>
      <span>{caption}</span>
    </figcaption>
  )}
</figure>

<style>
  .paper-figure {
    width: 100%;
    min-width: 0;
    margin: 2rem 0;
  }

  .figure-stage {
    display: grid;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    place-items: center;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .figure-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    object-fit: contain;
  }

  .paper-figure figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.55rem;
    margin-top: 0.65rem;
    padding: 0.55rem 0 0;
    border-top: 1px solid var(--rule);
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.55;
    text-align: left;
  }

  .paper-figure figcaption strong {
    align-self: start;
    color: var(--data-structure, var(--accent));
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  :global(.figure-stage > *) { max-width: 100%; }
  :global(.figure-stage img) { max-width: 100%; height: auto; }
  :global(.figure-stage svg),
  :global(.figure-stage canvas),
  :global(.figure-stage video) { max-width: 100%; }

  @media (max-width: 640px) {
    .paper-figure { margin-block: 1.6rem; }
    .paper-figure figcaption { grid-template-columns: 1fr; gap: 0.4rem; }
    .paper-figure figcaption strong { justify-self: start; }
  }
</style>
