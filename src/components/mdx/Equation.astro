---
interface Props {
  id?: string;
  number?: number | string;
}
const { id, number } = Astro.props;
const equationLabel = number !== undefined ? `Equation ${number}` : 'Display equation';
---

<div class="equation" id={id} role="group" aria-label={equationLabel}>
  <div class="equation-label">Equation</div>
  <div
    class="equation-body"
    tabindex="0"
    role="region"
    aria-label={`${equationLabel} expression; scroll horizontally if needed`}
  ><slot /></div>
  {number !== undefined && <div class="equation-number">({number})</div>}
</div>

<style>
  .equation {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    max-width: 100%;
    gap: 0.5rem 0.75rem;
    margin: 1.65rem 0;
    padding: 0.9rem 1rem;
    box-sizing: border-box;
    overflow: hidden;
    border-block: 1px solid var(--rule);
    background: color-mix(in oklab, var(--rule) 14%, transparent);
  }

  .equation-label {
    grid-column: 1 / -1;
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .equation-body {
    min-width: 0;
    max-width: 100%;
    padding: 0.25rem 0.1rem;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .equation-body:focus-visible {
    border-radius: 0.1rem;
    outline: 2px solid var(--data-structure, var(--accent));
    outline-offset: 2px;
  }

  .equation-number {
    padding-left: 0.4rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  :global(.equation-body .katex-display) {
    min-width: max-content;
    margin: 0;
    padding: 0;
    overflow: visible;
  }

  @media (max-width: 560px) {
    .equation {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
      margin-inline: -0.15rem;
      padding-inline: 0.65rem;
    }

    .equation-number { justify-self: end; }
    .equation-label { grid-column: 1; }
  }
</style>
