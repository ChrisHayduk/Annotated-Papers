---
interface Props {
  source?: string;
  section?: string;
  page?: number | string;
}
const { source, section, page } = Astro.props;
const parts: string[] = [];
if (source) parts.push(source);
if (section) parts.push(`§${section}`);
if (page !== undefined) parts.push(`p.${page}`);
const citation = parts.join(', ');
---
<blockquote class="paper-quote">
  <div class="paper-quote-label">Source excerpt</div>
  <div class="paper-quote-body"><slot /></div>
  {citation && <cite>{citation}</cite>}
</blockquote>

<style>
  .paper-quote {
    margin: 1.5rem 0;
    padding: 0.85rem 1rem;
    border: 0;
    border-left: 2px solid var(--data-structure, var(--accent));
    background: color-mix(in oklab, var(--data-structure, var(--accent)) 4%, transparent);
    color: var(--fg);
    font-style: normal;
  }

  .paper-quote-label {
    margin-bottom: 0.5rem;
    color: var(--data-structure, var(--accent));
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .paper-quote-body {
    font-size: 1.04em;
    font-style: italic;
    line-height: 1.65;
  }

  .paper-quote > cite {
    display: block;
    margin-top: 0.7rem;
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 550;
  }

  .paper-quote > cite::before {
    margin-right: 0.45rem;
    color: var(--data-structure, var(--accent));
    content: '—';
  }

  :global(.paper-quote-body > :first-child) { margin-top: 0; }
  :global(.paper-quote-body > :last-child) { margin-bottom: 0; }

  @media (max-width: 640px) {
    .paper-quote {
      padding: 0.8rem 0.85rem;
    }
  }
</style>
