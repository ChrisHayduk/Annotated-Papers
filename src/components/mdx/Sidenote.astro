---
interface Props {
  number?: number;
  id?: string;
}
const { number, id } = Astro.props;
const label = number !== undefined ? `Note ${number}` : 'Note';
---

<aside class="sidenote" id={id} aria-label={label}>
  <div class="sidenote-label">
    <span>Note</span>
    {number !== undefined && <sup>{number}</sup>}
  </div>
  <div class="sidenote-body"><slot /></div>
</aside>

<style>
  .sidenote {
    display: block;
    box-sizing: border-box;
    margin: 1rem 0;
    padding: 0.75rem 0.85rem;
    border-block: 1px solid var(--rule);
    border-left: 2px solid var(--data-msa, var(--accent));
    background: color-mix(in oklab, var(--rule) 16%, transparent);
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .sidenote-label {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    margin-bottom: 0.45rem;
    color: var(--data-msa, var(--accent));
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .sidenote-label sup {
    font-size: 0.62rem;
    letter-spacing: 0;
  }

  :global(.sidenote-body > :first-child) { margin-top: 0; }
  :global(.sidenote-body > :last-child) { margin-bottom: 0; }

  @media (min-width: 1200px) {
    .sidenote {
      float: right;
      clear: right;
      width: 17rem;
      margin: 0.2rem -18.5rem 1.25rem 1.5rem;
      padding: 0.2rem 0 0.2rem 0.85rem;
      border-block: 0;
      background: transparent;
    }
  }
</style>
