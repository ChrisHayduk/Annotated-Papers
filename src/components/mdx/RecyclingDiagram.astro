---
// Show the boundary between two forward passes rather than routing three
// separate states around a loop. The destinations are embeddings, not raw
// inputs; the coordinate path contributes only to the pair representation.
const routes = [
  {
    type: 'msa', source: 'Evoformer output', state: 'Target MSA row m₁',
    transform: 'LayerNorm', detail: 'Normalize the previous target row',
    destination: 'New target row m₁', addition: 'Add to the input embedding',
  },
  {
    type: 'pair', source: 'Evoformer output', state: 'Pair representation z',
    transform: 'LayerNorm', detail: 'Normalize the previous pair features',
    destination: 'New pair representation z', addition: 'Add to the input embedding',
  },
  {
    type: 'structure', source: 'Structure Module output', state: 'Predicted coordinates',
    transform: 'Distances → bins → projection', detail: 'Compute pairwise pseudo-β distances',
    destination: 'New pair representation z', addition: 'Add a second pair update',
  },
];
---
<figure class="recycle-fig" aria-labelledby="recycle-title">
  <header class="rec-heading">
    <span class="rec-kicker">BETWEEN FORWARD PASSES</span>
    <h4 id="recycle-title">What does the next pass reuse?</h4>
    <p>Three outputs become updates to fresh input embeddings. The next pass runs the same model with the same weights.</p>
  </header>

  <div class="rec-column-headings" aria-hidden="true">
    <span>Previous pass</span><span></span><span>Prepare the update</span><span></span><span>Next pass</span>
  </div>
  <div class="rec-routes">
    {routes.map((route, index) => (
      <div class:list={['rec-route', `rec-${route.type}`]}>
        <div class="rec-state rec-source">
          <span class="rec-node-label"><b>{index + 1}</b> {route.source}</span>
          <strong>{route.state}</strong>
        </div>
        <span class="rec-arrow" aria-hidden="true"></span>
        <div class="rec-transform">
          <span class="rec-node-label">Prepare the update</span>
          <strong>{route.transform}</strong>
          <span class="rec-node-note">{route.detail}</span>
        </div>
        <span class="rec-arrow" aria-hidden="true"></span>
        <div class:list={['rec-state', 'rec-destination', index === 0 ? 'rec-msa' : 'rec-pair']}>
          <span class="rec-node-label">Next-pass input</span>
          <strong>{route.destination}</strong>
          <span class="rec-node-note">{route.addition}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="rec-next">
    <span aria-hidden="true">↓</span>
    <p><strong>Run another forward pass.</strong> After the remaining input processing,
      the updated <i>m</i> and <i>z</i> enter the Evoformer, followed by the Structure Module.</p>
  </div>

  <figcaption>
    <strong>Recycling refines the prediction.</strong> The first pass has no previous prediction to reuse.
    Later passes reuse the target MSA row and pair features from the Evoformer,
    plus distances computed from the predicted structure. During training, the model detaches these previous-pass outputs:
    gradients flow through the final pass only.
  </figcaption>
</figure>

<style>
  .recycle-fig { margin: 1.75rem 0; padding: 1.35rem; border: 1px solid var(--rule-strong); border-radius: .7rem; background: var(--surface-strong); font-family: var(--font-sans); }
  .rec-kicker { color: var(--accent); font: 600 .65rem var(--font-mono); letter-spacing: .1em; }
  .rec-heading h4 { margin: .4rem 0 .35rem; color: var(--fg); font-size: 1.05rem; line-height: 1.45; }
  .rec-heading p { margin: 0; color: var(--fg-muted); font-size: .8rem; line-height: 1.6; max-width: 78ch; }
  .rec-column-headings, .rec-route { display: grid; grid-template-columns: 1fr 1.8rem 1.1fr 1.8rem 1fr; align-items: stretch; }
  .rec-column-headings { margin: 1.25rem 0 .55rem; color: var(--fg-muted); font: .65rem var(--font-mono); letter-spacing: .025em; }
  .rec-routes { display: grid; gap: .65rem; }
  .rec-msa { --stream: var(--data-msa); }
  .rec-pair { --stream: var(--data-pair); }
  .rec-structure { --stream: var(--data-structure); }
  .rec-state, .rec-transform { min-width: 0; padding: .8rem; border: 1px solid var(--rule); border-radius: .4rem; background: var(--bg); }
  .rec-state { border-color: color-mix(in oklab, var(--stream) 45%, var(--rule)); background: color-mix(in oklab, var(--stream) 6%, var(--surface-strong)); }
  .rec-node-label { display: block; color: var(--fg-muted); font-size: .62rem; line-height: 1.55; }
  .rec-node-label b { display: inline-block; margin-right: .25rem; color: var(--stream); font-family: var(--font-mono); }
  .rec-state strong, .rec-transform strong { display: block; margin-top: .3rem; color: var(--fg); font-size: .78rem; line-height: 1.5; }
  .rec-state strong { color: var(--stream); }
  .rec-node-note { display: block; margin-top: .35rem; color: var(--fg-muted); font-size: .68rem; line-height: 1.5; }
  .rec-arrow { align-self: center; justify-self: center; color: var(--stream); font-size: 1.3rem; }
  .rec-arrow::before { content: '→'; }
  .rec-next { display: flex; align-items: center; gap: .75rem; margin: .8rem 0; padding: .8rem 1rem; border: 1px solid var(--rule); border-radius: .4rem; background: var(--surface); }
  .rec-next > span { font-size: 1.5rem; color: var(--accent); }
  .rec-next p { margin: 0; color: var(--fg-muted); font-size: .75rem; line-height: 1.65; }
  .rec-next strong { color: var(--fg); }
  .recycle-fig figcaption { margin: 0; padding-top: .9rem; border-top: 1px solid var(--rule); font-size: .76rem; color: var(--fg-muted); line-height: 1.65; }
  .recycle-fig figcaption strong { color: var(--fg); }
  @media (max-width: 640px) {
    .recycle-fig { padding: 1rem .8rem; }
    .rec-column-headings { display: none; }
    .rec-routes { grid-template-columns: 1fr; gap: .85rem; margin-top: 1rem; }
    .rec-route { grid-template-columns: 1fr; padding: .6rem; border: 1px solid var(--rule); border-radius: .5rem; }
    .rec-state, .rec-transform { padding: .65rem .75rem; }
    .rec-arrow { line-height: 1.3; }
    .rec-arrow::before { content: '↓'; }
    .rec-transform .rec-node-label { display: none; }
    .rec-transform strong { margin-top: 0; }
    .rec-next { padding: .75rem; }
  }
</style>
