---
import '../styles/global.css';
import '../styles/paper.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  robots?: string;
}

const { title, description, ogImage = '/og.png', ogType = 'website', jsonLd, robots } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const resolvedOg = ogImage ? new URL(ogImage, Astro.url.origin).toString() : undefined;
const currentPath = Astro.url.pathname;
const isAbout = currentPath === '/about' || currentPath === '/about/';
const isLibrary = currentPath === '/';

// Google Search Console verification token. Set GOOGLE_SITE_VERIFICATION in
// the Cloudflare Pages build environment (Settings → Environment variables)
// with the content value Google gives you when you add a URL-prefix property
// for https://annotated.chrishayduk.com/. Not a secret — it's public in the
// rendered HTML — but keeping it in env rather than in source means the token
// can be changed without a commit.
const gscToken =
  (import.meta.env as Record<string, string | undefined>).GOOGLE_SITE_VERIFICATION ??
  (typeof process !== 'undefined' ? process.env.GOOGLE_SITE_VERIFICATION : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {resolvedOg && <meta property="og:image" content={resolvedOg} />}
    {resolvedOg && <meta property="og:image:width" content="1200" />}
    {resolvedOg && <meta property="og:image:height" content="630" />}
    {resolvedOg && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content="summary_large_image" />
    {resolvedOg && <meta name="twitter:image" content={resolvedOg} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f1ece3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100f0e" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title="Annotated Papers by Chris Hayduk" href="/rss.xml" />

    {gscToken && <meta name="google-site-verification" content={gscToken} />}

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const shouldDark = stored ? stored === 'dark' : prefersDark;
          if (shouldDark) document.documentElement.classList.add('dark');
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-nav">
      <div class="site-nav-inner">
        <a href="/" class="site-brand" aria-label="Annotated Papers by Chris Hayduk, home">
          <span class="site-brand-mark" aria-hidden="true">AP</span>
          <span class="site-brand-copy">
            <span class="site-brand-name">Annotated Papers</span>
            <span class="site-brand-byline">by Chris Hayduk</span>
          </span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="/" aria-current={isLibrary ? 'page' : undefined}>Library</a>
          <a href="/about" aria-current={isAbout ? 'page' : undefined}>Method</a>
          <a class="nav-notes" href="https://chrishayduk.com" rel="me">Notes&nbsp;↗</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode">
            <span class="theme-toggle-moon" aria-hidden="true">☾</span>
            <span class="theme-toggle-sun" aria-hidden="true">☀</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="site-main" id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div>
          <p class="site-footer-brand">Research papers, opened up.</p>
          <p class="site-footer-copy">
            Guided technical walkthroughs connecting the paper, the mathematics,
            readable implementations, and interactive experiments.
          </p>
        </div>
        <nav class="site-footer-links" aria-label="Footer navigation">
          <a href="/">Library</a>
          <a href="/about">Method</a>
          <a href="/rss.xml">RSS</a>
          <a href="https://github.com/ChrisHayduk" rel="me">GitHub ↗</a>
          <a href="https://chrishayduk.com" rel="me">Chris Hayduk ↗</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      const syncThemeControl = () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const isDark = document.documentElement.classList.contains('dark');
        btn.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} mode`);
        btn.setAttribute('title', `Switch to ${isDark ? 'light' : 'dark'} mode`);
      };
      syncThemeControl();
      btn?.addEventListener('click', () => {
        const html = document.documentElement;
        const next = html.classList.toggle('dark') ? 'dark' : 'light';
        try { localStorage.setItem('theme', next); } catch {}
        syncThemeControl();
      });
    </script>
  </body>
</html>
