---
import '../styles/global.css';
import '../styles/paper.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  robots?: string;
}

const { title, description, ogImage = '/og.png', ogType = 'website', jsonLd, robots } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const resolvedOg = ogImage ? new URL(ogImage, Astro.url.origin).toString() : undefined;
const currentPath = Astro.url.pathname;
const isAbout = currentPath === '/about' || currentPath === '/about/';
const isLibrary = currentPath === '/';

// Google Search Console verification token. Set GOOGLE_SITE_VERIFICATION in
// the Cloudflare Pages build environment (Settings → Environment variables)
// with the content value Google gives you when you add a URL-prefix property
// for https://annotated.chrishayduk.com/. Not a secret — it's public in the
// rendered HTML — but keeping it in env rather than in source means the token
// can be changed without a commit.
const gscToken =
  (import.meta.env as Record<string, string | undefined>).GOOGLE_SITE_VERIFICATION ??
  (typeof process !== 'undefined' ? process.env.GOOGLE_SITE_VERIFICATION : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Annotated Papers by Chris Hayduk" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {resolvedOg && <meta property="og:image" content={resolvedOg} />}
    {resolvedOg && <meta property="og:image:width" content="1200" />}
    {resolvedOg && <meta property="og:image:height" content="630" />}
    {resolvedOg && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content="summary_large_image" />
    {resolvedOg && <meta name="twitter:image" content={resolvedOg} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=papers-1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=papers-1" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=papers-1" />
    <meta name="theme-color" content="#f7f8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101f1a" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title="Annotated Papers by Chris Hayduk" href="/rss.xml" />

    {gscToken && <meta name="google-site-verification" content={gscToken} />}

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const shouldDark = stored ? stored === 'dark' : prefersDark;
          if (shouldDark) document.documentElement.classList.add('dark');
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-nav">
      <div class="site-nav-inner">
        <a href="/" class="site-brand" aria-label="Annotated Papers by Chris Hayduk, home">
          <img class="site-brand-mark" src="/brand-mark.svg" width="48" height="48" alt="" />
          <span class="site-brand-copy">
            <span class="site-brand-name">Annotated Papers</span>
            <span class="site-brand-byline">by Chris Hayduk</span>
          </span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="/" aria-current={isLibrary ? 'page' : undefined}>Papers</a>
          <a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a>
          <a class="nav-personal" href="https://chrishayduk.com" rel="me">ChrisHayduk.com <span aria-hidden="true">↗</span></a>
          <a class="nav-practice" href="https://biotorch.chrishayduk.com"><span class="nav-practice-full">Practice on BioTorch</span><span class="nav-practice-short">BioTorch</span> <span aria-hidden="true">↗</span></a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode">
            <svg class="theme-toggle-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.8 13.1A9 9 0 0 1 10.9 3.2 9 9 0 1 0 20.8 13.1Z" /></svg>
            <svg class="theme-toggle-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="site-main" id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <div>
          <p class="site-footer-brand">Annotated Papers <span>by Chris Hayduk</span></p>
          <p class="site-footer-copy">Research notes and implementations by <a href="https://chrishayduk.com" rel="me">Chris Hayduk</a>.</p>
        </div>
        <nav class="site-footer-links" aria-label="Footer navigation">
          <a href="/">Papers</a>
          <a href="/about">About</a>
          <a href="https://chrishayduk.com" rel="me">ChrisHayduk.com&nbsp;↗</a>
          <a href="https://biotorch.chrishayduk.com">BioTorch&nbsp;↗</a>
          <a href="/rss.xml">RSS</a>
          <a href="https://github.com/ChrisHayduk" rel="me">GitHub&nbsp;↗</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      const syncThemeControl = () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        const isDark = document.documentElement.classList.contains('dark');
        btn.setAttribute('aria-label', `Switch to ${isDark ? 'light' : 'dark'} mode`);
        btn.setAttribute('title', `Switch to ${isDark ? 'light' : 'dark'} mode`);
      };
      syncThemeControl();
      btn?.addEventListener('click', () => {
        const html = document.documentElement;
        const next = html.classList.toggle('dark') ? 'dark' : 'light';
        try { localStorage.setItem('theme', next); } catch {}
        syncThemeControl();
      });
    </script>
  </body>
</html>
