---
import BaseLayout from './BaseLayout.astro';
import PaperHeader from '../components/paper/PaperHeader.astro';
import TOC from '../components/paper/TOC.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface PaperFrontmatter {
  slug: string;
  title: string;
  subtitle?: string;
  authors: string[];
  annotator: string;
  paperYear: number;
  arxivId?: string;
  doi?: string;
  venue?: string;
  publishedDate: Date;
  updatedDate?: Date;
  tags: string[];
  readingTimeMinutes?: number;
  chapterCount?: number;
  codeSnippetCount?: number;
  interactiveCount?: number;
  description: string;
  heroFigure?: string;
  referenceRepo?: { url: string; commit: string };
}

interface Props {
  frontmatter: PaperFrontmatter;
  headings: Heading[];
}

const { frontmatter, headings } = Astro.props;
const paperAuthors = frontmatter.authors.filter((author) => author.toLowerCase() !== 'et al.');
const pageUrl = new URL(`/${frontmatter.slug}`, Astro.site ?? 'https://annotated.chrishayduk.com').toString();
const originalPaperUrl = frontmatter.doi
  ? `https://doi.org/${frontmatter.doi}`
  : frontmatter.arxivId
    ? `https://arxiv.org/abs/${frontmatter.arxivId}`
    : undefined;
const chapterCount = frontmatter.chapterCount ?? headings.filter((heading) => heading.depth === 2).length;

const annotatorPerson = {
  '@type': 'Person' as const,
  name: frontmatter.annotator,
  url: 'https://chrishayduk.com',
  sameAs: [
    'https://chrishayduk.com',
    'https://github.com/ChrisHayduk',
    'https://x.com/ChrisHayduk',
    'https://www.linkedin.com/in/chrishayduk/'
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: frontmatter.title,
  datePublished: frontmatter.publishedDate.toISOString(),
  dateModified: (frontmatter.updatedDate ?? frontmatter.publishedDate).toISOString(),
  author: annotatorPerson,
  publisher: annotatorPerson,
  description: frontmatter.description,
  inLanguage: 'en',
  keywords: frontmatter.tags,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  isBasedOn: {
    '@type': 'ScholarlyArticle',
    name: frontmatter.title.replace(/^The Annotated /, ''),
    author: paperAuthors.map((name) => ({ '@type': 'Person', name })),
    datePublished: String(frontmatter.paperYear),
    identifier: frontmatter.doi ?? frontmatter.arxivId,
    url: originalPaperUrl,
  },
  isPartOf: {
    '@type': 'WebSite' as const,
    name: 'Annotated Papers by Chris Hayduk',
    url: Astro.site?.toString() ?? 'https://annotated.chrishayduk.com/',
  },
};
---

<BaseLayout
  title={`${frontmatter.title} — Annotated Papers by Chris Hayduk`}
  description={frontmatter.description}
  ogImage={`/og/${frontmatter.slug}.png`}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="reading-progress" aria-hidden="true">
    <span id="reading-progress-bar"></span>
  </div>

  <div class="mobile-reader-dock" id="mobile-reader-dock">
    <details id="mobile-contents">
      <summary>
        <span class="mobile-reader-label">
          <span class="mobile-reader-kicker">Current section</span>
          <span id="mobile-current-section">Paper overview</span>
        </span>
        <span class="mobile-reader-meta"><span data-reading-percent>0%</span><span class="mobile-contents-toggle">Contents <span class="mobile-contents-chevron" aria-hidden="true">⌄</span></span></span>
      </summary>
      <div class="mobile-toc-panel">
        <div class="mobile-toc-head">
          <span>{chapterCount} chapters</span>
          <span>{frontmatter.readingTimeMinutes ? `${frontmatter.readingTimeMinutes} min` : 'Article'}</span>
        </div>
        <TOC headings={headings} />
      </div>
    </details>
  </div>

  <div class="paper-shell" data-paper-slug={frontmatter.slug}>
    <aside class="paper-toc-column" aria-label="Reading navigation">
      <div class="paper-toc-intro">
        <a href="#paper-top">In this paper</a>
        <span><span data-reading-percent>0%</span> read</span>
      </div>
      <div class="toc-progress-track" aria-hidden="true"><span data-toc-progress></span></div>
      <TOC headings={headings} />
      <a class="toc-back-top" href="#paper-top">Back to overview <span aria-hidden="true">↑</span></a>
    </aside>

    <article class="prose paper-article">
      <PaperHeader frontmatter={frontmatter} chapterCount={chapterCount} headings={headings} />
      <div class="paper-body" id="paper-introduction">
        <slot />
      </div>
      <div class="paper-next-step">
        <div>
          <p class="paper-next-kicker">BioTorch exercises</p>
          <h2>Try implementing the operations.</h2>
          <p>Practice attention, protein geometry, and related operations in PyTorch, with tests to check your code.</p>
        </div>
        <a href="https://biotorch.chrishayduk.com" class="button-primary">Practice on BioTorch <span aria-hidden="true">↗</span></a>
      </div>
    </article>

  </div>

  <script is:inline define:vars={{ paperSlug: frontmatter.slug }}>
    (() => {
      const article = document.querySelector('.paper-article');
      const progressBar = document.getElementById('reading-progress-bar');
      const tocProgress = document.querySelector('[data-toc-progress]');
      const percentLabels = document.querySelectorAll('[data-reading-percent]');
      const mobileCurrent = document.getElementById('mobile-current-section');
      const mobileDetails = document.getElementById('mobile-contents');
      const storageKey = `annotated-papers:${paperSlug}:last-section`;
      let queued = false;

      // Offer the previous position before scrollspy records the current visit.
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) ?? 'null');
        const resume = document.getElementById('paper-resume');
        const label = document.getElementById('paper-resume-label');
        if (saved?.id && saved?.text && document.getElementById(saved.id) && resume && label) {
          resume.setAttribute('href', `#${saved.id}`);
          label.textContent = saved.text;
          resume.hidden = false;
        }
      } catch {}

      const updateProgress = () => {
        queued = false;
        if (!(article instanceof HTMLElement)) return;
        const start = article.offsetTop;
        const end = start + article.offsetHeight - window.innerHeight;
        const ratio = end <= start ? 1 : Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
        const percentage = Math.round(ratio * 100);
        if (progressBar) progressBar.style.transform = `scaleX(${ratio})`;
        if (tocProgress instanceof HTMLElement) tocProgress.style.transform = `scaleX(${ratio})`;
        percentLabels.forEach((label) => { label.textContent = `${percentage}%`; });
      };

      const scheduleProgress = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(updateProgress);
      };

      document.addEventListener('paper-section-change', (event) => {
        const detail = event.detail;
        if (!detail?.text) return;
        if (mobileCurrent) mobileCurrent.textContent = detail.text;
        if (!detail.id) return;
        try { localStorage.setItem(storageKey, JSON.stringify(detail)); } catch {}
      });

      document.querySelectorAll('.mobile-toc-panel a').forEach((link) => {
        link.addEventListener('click', () => {
          if (mobileDetails instanceof HTMLDetailsElement) mobileDetails.open = false;
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileDetails instanceof HTMLDetailsElement && mobileDetails.open) {
          mobileDetails.open = false;
          mobileDetails.querySelector('summary')?.focus();
        }
      });

      window.addEventListener('scroll', scheduleProgress, { passive: true });
      window.addEventListener('resize', scheduleProgress, { passive: true });
      updateProgress();
    })();
  </script>
</BaseLayout>

<style is:global>
  .reading-progress {
    position: fixed;
    z-index: 60;
    top: calc(var(--header-height) - 2px);
    left: 0;
    right: 0;
    height: 3px;
    pointer-events: none;
  }

  #reading-progress-bar {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--accent);
    transition: transform 80ms linear;
  }

  .paper-shell {
    max-width: 96rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .paper-toc-column { display: none; }

  .mobile-reader-dock {
    position: sticky;
    z-index: 35;
    top: var(--header-height);
    border-bottom: 1px solid var(--rule);
    background: var(--surface-strong);
    font-family: var(--font-sans);
  }

  .mobile-reader-dock summary {
    min-height: 3.75rem;
    padding: 0.55rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
  }

  .mobile-reader-dock summary::-webkit-details-marker { display: none; }
  .mobile-reader-label { min-width: 0; display: grid; gap: 0.12rem; }
  .mobile-reader-kicker {
    color: var(--fg-muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  #mobile-current-section {
    overflow: hidden;
    color: var(--fg);
    font-size: 0.75rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mobile-reader-meta {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--fg-muted);
    font-size: 0.65rem;
    font-weight: 600;
  }
  .mobile-contents-toggle { display: flex; align-items: center; gap: 0.45rem; color: var(--accent); }
  .mobile-contents-chevron { display: inline-block; font-size: 1.1rem; transition: transform 150ms ease; }
  #mobile-contents[open] .mobile-contents-chevron { transform: rotate(180deg); }
  .paper-toc-intro a { color: var(--fg); font-size: 0.75rem; font-weight: 600; text-decoration: none; }
  .paper-toc-intro a:hover { color: var(--accent); }
  .toc-progress-track { height: 3px; margin: -0.3rem 0 1.5rem; overflow: hidden; border-radius: 1rem; background: var(--rule); }
  .toc-progress-track > span { display: block; width: 100%; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .toc-back-top { display: flex; align-items: center; justify-content: space-between; min-height: 2.75rem; margin: 1.25rem 0 0; border-top: 1px solid var(--rule); color: var(--fg-muted); font: 500 0.7rem/1.5 var(--font-sans); text-decoration: none; }
  .toc-back-top:hover { color: var(--accent); }
  .paper-next-step { display: grid; gap: 1.2rem; justify-items: start; margin-top: 4rem; padding: 1.75rem; border: 1px solid var(--rule); border-radius: 0.6rem; background: var(--surface); font-family: var(--font-sans); }
  .paper-next-step .paper-next-kicker { margin: 0 0 0.8rem; color: var(--accent); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .paper-next-step h2 { margin: 0 0 0.6rem; font: 600 1.6rem/1.2 var(--font-sans); letter-spacing: -0.035em; }
  .paper-next-step p { margin: 0; color: var(--fg-muted); font-size: 0.85rem; line-height: 1.65; }
  @media (max-width: 1023px) {
    .paper-article :is(h2, h3, h4), #paper-top, #paper-introduction { scroll-margin-top: 5rem; }
  }

  .mobile-toc-panel {
    max-height: calc(100dvh - var(--header-height) - 3.75rem);
    overflow-y: auto;
    border-top: 1px solid var(--rule);
    padding: 1rem;
    background: var(--surface-strong);
  }

  .mobile-toc-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
    color: var(--fg-muted);
    font-size: 0.68rem;
  }

  @media (min-width: 1024px) {
    .mobile-reader-dock { display: none; }

    .paper-shell {
      grid-template-columns: 16.5rem minmax(0, 1fr) 4rem;
    }

    .paper-toc-column {
      display: block;
      position: sticky;
      top: var(--header-height);
      align-self: start;
      max-height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      padding: 2.6rem 1.25rem 2rem 1.5rem;
      border-right: 1px solid var(--rule);
      background: color-mix(in oklab, var(--surface) 40%, var(--bg));
      scrollbar-width: thin;
    }

    .paper-toc-intro {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 1rem;
      padding-bottom: 0.8rem;
      font-family: var(--font-sans);
    }

    .paper-toc-intro p,
    .paper-toc-intro span { margin: 0; }
    .paper-toc-intro p { color: var(--fg); font-size: 0.72rem; font-weight: 700; }
    .paper-toc-intro span { color: var(--fg-muted); font-size: 0.64rem; }
  }

  /* The right column is kept open for margin notes used by the annotation. */
  @media (min-width: 1200px) {
    .paper-shell {
      grid-template-columns: 17rem minmax(0, 1fr) 17rem;
    }
  }
</style>
