---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('papers', (e) => !e.data.draft)).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
const featured = entries.find((entry) => entry.data.slug === 'alphafold2') ?? entries[0];

// Site-level JSON-LD. Establishes that the site is authored and published by
// Chris Hayduk, and points at chrishayduk.com via author.sameAs. Search
// engines use sameAs to collapse identities across domains — the thing we
// most want for a fresh subdomain that needs to inherit trust from the
// main domain.
const PERSON = {
  '@type': 'Person' as const,
  name: 'Chris Hayduk',
  url: 'https://chrishayduk.com',
  sameAs: [
    'https://chrishayduk.com',
    'https://github.com/ChrisHayduk',
    'https://x.com/ChrisHayduk',
    'https://www.linkedin.com/in/chrishayduk/'
  ],
};

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Annotated Papers by Chris Hayduk',
  alternateName: 'Annotated Papers',
  url: Astro.site?.toString() ?? 'https://annotated.chrishayduk.com/',
  description:
    'Walkthrough-style annotations of research papers worth reading deeply, by Chris Hayduk.',
  author: PERSON,
  publisher: PERSON,
  inLanguage: 'en',
};
---
<BaseLayout
  title="Annotated Papers by Chris Hayduk"
  description="Walkthrough-style annotations of research papers worth reading deeply — by Chris Hayduk."
  jsonLd={siteJsonLd}
>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span>Annotated Papers</span> Research, made legible</p>
        <h1 id="hero-title">Read the paper.<br /><em>See the system.</em></h1>
        <p class="hero-lede">
          Deep, guided walkthroughs of consequential research — combining the
          original argument, runnable code, and interactive figures in one continuous reading experience.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/alphafold2">
            Begin with AlphaFold2 <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="/about">How the annotations work <span aria-hidden="true">↗</span></a>
        </div>
      </div>

      <div class="hero-figure" role="img" aria-label="A conceptual path from biological sequence to three-dimensional structure">
        <div class="figure-index">Fig. 01 <span>Sequence → structure</span></div>
        <div class="sequence-strip" aria-hidden="true">
          <span>M</span><span>K</span><span>V</span><span>L</span><span>W</span><span>A</span><span>G</span><span>H</span><span>E</span><span>R</span><span>T</span><span>Y</span>
        </div>
        <div class="figure-field" aria-hidden="true">
          <div class="pair-grid">
            {Array.from({ length: 36 }, (_, i) => <i class:list={{ hot: [2, 8, 14, 20, 27, 28, 33].includes(i), cool: [5, 10, 17, 22, 25, 31].includes(i) }}></i>)}
          </div>
          <div class="structure-trace">
            <span class="trace-label">predicted frame</span>
            <b class="node node-a"></b>
            <b class="node node-b"></b>
            <b class="node node-c"></b>
            <b class="node node-d"></b>
            <b class="node node-e"></b>
          </div>
        </div>
        <div class="figure-caption">
          <span>01 / sequence</span>
          <span>02 / pair field</span>
          <span>03 / geometry</span>
        </div>
      </div>
    </section>

    {featured ? (
      <section class="featured" aria-labelledby="featured-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span>Current dossier</span> No. 01</p>
            <h2 id="featured-title">One paper,<br />opened all the way.</h2>
          </div>
          <p>
            The complete annotation is designed as a single long-form study session:
            conceptual framing, implementation detail, and experiments stay side by side.
          </p>
        </div>

        <article class="dossier-card">
          <div class="dossier-main">
            <div class="dossier-meta">
              <span>{featured.data.venue} · {featured.data.paperYear}</span>
              <span>Structural biology / deep learning</span>
            </div>
            <p class="dossier-kicker">Jumper et al.</p>
            <h3>{featured.data.title}</h3>
            <p class="dossier-description">{featured.data.description}</p>
            <div class="dossier-actions">
              <a class="button button-primary" href={`/${featured.data.slug}`}>
                Read the annotation <span aria-hidden="true">→</span>
              </a>
              <a class="button button-secondary" href={featured.data.referenceRepo?.url ?? 'https://github.com/ChrisHayduk/minAlphaFold2'} target="_blank" rel="noopener">
                Browse the code <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="dossier-aside">
            <div class="folio" aria-hidden="true">
              <span class="folio-mark">AF</span>
              <span class="folio-number">02</span>
              <div class="folio-orbit orbit-one"></div>
              <div class="folio-orbit orbit-two"></div>
              <i class="folio-dot dot-one"></i>
              <i class="folio-dot dot-two"></i>
              <i class="folio-dot dot-three"></i>
            </div>
            <dl class="metrics" aria-label="Annotation contents">
              <div><dt>Chapters</dt><dd>{featured.data.chapterCount ?? 16}</dd></div>
              <div><dt>Code excerpts</dt><dd>{featured.data.codeSnippetCount ?? 37}</dd></div>
              <div><dt>Interactives</dt><dd>{featured.data.interactiveCount ?? 8}</dd></div>
              <div><dt>Reading time</dt><dd>{featured.data.readingTimeMinutes ?? 90} <small>min</small></dd></div>
            </dl>
          </div>
        </article>
      </section>
    ) : (
      <p class="empty-state">The first annotation is being prepared.</p>
    )}

    <section class="method" aria-labelledby="method-title">
      <div class="method-intro">
        <p class="eyebrow"><span>The method</span> Three views, one argument</p>
        <h2 id="method-title">Understanding arrives<br />when the views agree.</h2>
      </div>

      <ol class="method-list">
        <li>
          <span class="method-number">01</span>
          <div class="method-icon paper-icon" aria-hidden="true"><i></i><i></i><i></i></div>
          <h3>The paper</h3>
          <p>The original claims, equations, and architecture are unpacked in the order the ideas depend on one another.</p>
        </li>
        <li>
          <span class="method-number">02</span>
          <div class="method-icon code-icon" aria-hidden="true"><i></i><i></i><i></i></div>
          <h3>The code</h3>
          <p>Paper-aligned PyTorch turns each abstraction into a readable, tested implementation you can run yourself.</p>
        </li>
        <li>
          <span class="method-number">03</span>
          <div class="method-icon interactive-icon" aria-hidden="true"><i></i><i></i><i></i></div>
          <h3>The interactive</h3>
          <p>Purpose-built figures make attention, geometry, and optimization available to intuition — not just notation.</p>
        </li>
      </ol>
    </section>

    <aside class="closing-note">
      <p>Built for the moment when “I read it” becomes <em>“I understand how it works.”</em></p>
      <a href="/alphafold2">Open the AlphaFold2 dossier <span aria-hidden="true">→</span></a>
    </aside>
  </div>
</BaseLayout>

<style>
  .home {
    --page-canvas: var(--canvas, var(--bg));
    --page-paper: var(--paper, var(--surface, var(--bg)));
    --page-surface: var(--surface, color-mix(in srgb, var(--bg) 92%, var(--fg)));
    --page-accent-soft: var(--accent-soft, color-mix(in srgb, var(--accent) 10%, transparent));
    --msa: var(--data-msa, #2c7a78);
    --structure: var(--data-structure, #c45b3c);
    background:
      radial-gradient(circle at 78% 9%, color-mix(in srgb, var(--msa) 8%, transparent), transparent 27rem),
      var(--page-canvas);
    overflow-x: clip;
  }

  .hero,
  .featured,
  .method,
  .closing-note {
    width: min(100% - 3rem, 76rem);
    margin-inline: auto;
  }

  .hero {
    min-height: min(49rem, calc(100svh - 4rem));
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(27rem, 0.97fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding-block: clamp(5rem, 10vw, 9.5rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.35rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .eyebrow span {
    color: var(--accent);
  }

  .eyebrow::before {
    width: 2.5rem;
    height: 1px;
    background: currentColor;
    content: '';
  }

  .hero h1 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(3.9rem, 7.4vw, 7.25rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.87;
  }

  .hero h1 em {
    color: var(--accent);
    font-weight: 400;
  }

  .hero-lede {
    max-width: 37rem;
    margin: 2.4rem 0 0;
    color: var(--fg-muted);
    font-size: clamp(1.1rem, 1.55vw, 1.28rem);
    line-height: 1.62;
  }

  .hero-actions,
  .dossier-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.35rem;
    font-family: var(--font-sans);
  }

  .button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    padding: 0 1.3rem;
    border: 1px solid transparent;
    font-size: 0.83rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--fg);
    color: var(--bg);
  }

  .button-primary:hover {
    background: var(--accent);
    color: var(--page-paper);
  }

  .button-secondary {
    border-color: var(--rule);
    color: var(--fg);
  }

  .button-secondary:hover {
    border-color: var(--fg-muted);
  }

  .text-link {
    padding: 0.8rem 0.2rem;
    color: var(--fg-muted);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--accent);
  }

  .hero-figure {
    position: relative;
    min-height: 30rem;
    padding: 1.35rem;
    border: 1px solid var(--rule);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--rule) 45%, transparent) 1px, transparent 1px),
      linear-gradient(color-mix(in srgb, var(--rule) 45%, transparent) 1px, transparent 1px),
      var(--page-paper);
    background-size: 2.75rem 2.75rem;
    box-shadow: 1.25rem 1.25rem 0 color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .hero-figure::after {
    position: absolute;
    inset: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--rule) 65%, transparent);
    content: '';
    pointer-events: none;
  }

  .figure-index,
  .figure-caption {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .figure-index span {
    color: var(--accent);
  }

  .sequence-strip {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    margin: 3.1rem 0 1.4rem;
    border: 1px solid var(--rule);
    background: var(--page-surface);
  }

  .sequence-strip span {
    display: grid;
    min-width: 0;
    aspect-ratio: 1;
    place-items: center;
    border-right: 1px solid var(--rule);
    color: var(--msa);
    font-family: var(--font-mono);
    font-size: clamp(0.5rem, 1vw, 0.68rem);
    font-weight: 700;
  }

  .sequence-strip span:last-child {
    border-right: 0;
  }

  .figure-field {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 42% 58%;
    min-height: 15.5rem;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--page-paper) 92%, transparent);
  }

  .pair-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-self: center;
    margin: 1.4rem;
    border: 1px solid var(--rule);
  }

  .pair-grid i {
    aspect-ratio: 1;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--page-surface) 80%, transparent);
  }

  .pair-grid i.hot { background: color-mix(in srgb, var(--structure) 68%, var(--page-paper)); }
  .pair-grid i.cool { background: color-mix(in srgb, var(--msa) 54%, var(--page-paper)); }

  .structure-trace {
    position: relative;
    overflow: hidden;
    border-left: 1px solid var(--rule);
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--structure) 8%, transparent), transparent 65%);
  }

  .structure-trace::before,
  .structure-trace::after {
    position: absolute;
    width: 72%;
    height: 38%;
    border: 2px solid var(--structure);
    border-right-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    content: '';
    transform: rotate(-28deg);
  }

  .structure-trace::before { top: 23%; left: 5%; }
  .structure-trace::after { right: -5%; bottom: 14%; transform: rotate(150deg); }

  .trace-label {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .node {
    position: absolute;
    z-index: 2;
    width: 0.55rem;
    height: 0.55rem;
    border: 2px solid var(--page-paper);
    border-radius: 50%;
    background: var(--structure);
    box-shadow: 0 0 0 1px var(--structure);
  }

  .node-a { top: 42%; left: 16%; }
  .node-b { top: 27%; left: 41%; }
  .node-c { top: 48%; left: 61%; }
  .node-d { top: 67%; left: 77%; }
  .node-e { top: 73%; left: 42%; }

  .figure-caption {
    margin-top: 1.2rem;
  }

  .featured {
    padding-block: clamp(5rem, 9vw, 8rem);
    border-top: 1px solid var(--rule);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr minmax(18rem, 28rem);
    align-items: end;
    gap: 4rem;
    margin-bottom: 3rem;
  }

  .section-heading h2,
  .method-intro h2 {
    margin: 0;
    font-size: clamp(2.65rem, 5vw, 4.65rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.97;
  }

  .section-heading > p {
    margin: 0 0 0.2rem;
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .dossier-card {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    min-height: 34rem;
    border: 1px solid var(--rule);
    background: var(--page-paper);
    box-shadow: 0 1.25rem 4rem color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .dossier-main {
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 5vw, 4rem);
  }

  .dossier-meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dossier-kicker {
    margin: auto 0 0.7rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.03em;
  }

  .dossier-main h3 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(3rem, 6vw, 5.85rem);
    font-weight: 400;
    letter-spacing: -0.052em;
    line-height: 0.89;
  }

  .dossier-description {
    max-width: 44rem;
    margin: 1.65rem 0 0;
    color: var(--fg-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .dossier-aside {
    display: grid;
    grid-template-rows: 1fr auto;
    border-left: 1px solid var(--rule);
    background:
      linear-gradient(color-mix(in srgb, var(--rule) 38%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--rule) 38%, transparent) 1px, transparent 1px),
      var(--page-surface);
    background-size: 2rem 2rem;
  }

  .folio {
    position: relative;
    display: grid;
    min-height: 19rem;
    place-content: center;
    overflow: hidden;
  }

  .folio-mark,
  .folio-number {
    position: relative;
    z-index: 2;
    color: var(--fg);
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.75;
  }

  .folio-mark { font-size: clamp(3.8rem, 7vw, 6.5rem); }
  .folio-number { color: var(--accent); font-size: clamp(3.8rem, 7vw, 6.5rem); text-align: right; }

  .folio-orbit {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--msa) 70%, var(--rule));
    border-radius: 50%;
  }

  .orbit-one { inset: 16% 18%; transform: rotate(30deg); }
  .orbit-two { inset: 27% 8%; transform: rotate(-39deg); }

  .folio-dot {
    position: absolute;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--msa);
    box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--msa) 14%, transparent);
  }

  .dot-one { top: 19%; right: 28%; }
  .dot-two { bottom: 25%; left: 16%; background: var(--structure); }
  .dot-three { right: 12%; bottom: 36%; }

  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border-top: 1px solid var(--rule);
    background: color-mix(in srgb, var(--page-paper) 92%, transparent);
  }

  .metrics div {
    display: flex;
    min-height: 6.5rem;
    flex-direction: column-reverse;
    justify-content: space-between;
    padding: 1rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .metrics div:nth-child(even) { border-right: 0; }
  .metrics div:nth-last-child(-n + 2) { border-bottom: 0; }

  .metrics dt {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .metrics dd {
    margin: 0;
    font-size: 2.15rem;
    line-height: 1;
  }

  .metrics small {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
  }

  .method {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .method-intro {
    align-self: start;
    position: sticky;
    top: 3rem;
  }

  .method-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .method-list li {
    display: grid;
    grid-template-columns: 2.5rem 4.5rem 1fr;
    column-gap: 1.2rem;
    padding: 2.1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .method-number {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .method-icon {
    position: relative;
    grid-row: span 2;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--rule);
    background: var(--page-paper);
  }

  .method-icon i {
    position: absolute;
    display: block;
  }

  .paper-icon i { left: 0.7rem; right: 0.7rem; height: 1px; background: var(--fg-muted); }
  .paper-icon i:nth-child(1) { top: 0.9rem; }
  .paper-icon i:nth-child(2) { top: 1.5rem; }
  .paper-icon i:nth-child(3) { top: 2.1rem; right: 1.35rem; }

  .code-icon i { top: 1.05rem; width: 0.85rem; height: 0.85rem; border-top: 1px solid var(--msa); border-left: 1px solid var(--msa); }
  .code-icon i:nth-child(1) { left: 0.7rem; transform: rotate(-45deg); }
  .code-icon i:nth-child(2) { right: 0.7rem; transform: rotate(135deg); }
  .code-icon i:nth-child(3) { top: 0.8rem; left: 1.55rem; width: 1px; height: 1.65rem; border: 0; background: var(--msa); transform: rotate(18deg); }

  .interactive-icon i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--structure); }
  .interactive-icon i:nth-child(1) { top: 0.65rem; left: 1.35rem; }
  .interactive-icon i:nth-child(2) { right: 0.7rem; bottom: 0.75rem; }
  .interactive-icon i:nth-child(3) { bottom: 0.6rem; left: 0.65rem; }
  .interactive-icon::after { position: absolute; inset: 0.9rem 0.75rem 0.8rem; border: 1px solid var(--structure); content: ''; transform: rotate(34deg); }

  .method-list h3 {
    margin: 0 0 0.55rem;
    font-size: 1.55rem;
    font-weight: 500;
  }

  .method-list p {
    grid-column: 3;
    max-width: 37rem;
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .closing-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--fg);
  }

  .closing-note p {
    max-width: 44rem;
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
