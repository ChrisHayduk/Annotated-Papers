---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('papers', (e) => !e.data.draft)).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
const featured = entries.find((entry) => entry.data.slug === 'alphafold2') ?? entries[0];
const featuredRepo = featured?.data.referenceRepo;

// Site-level JSON-LD. Establishes that the site is authored and published by
// Chris Hayduk, and points at chrishayduk.com via author.sameAs. Search
// engines use sameAs to collapse identities across domains — the thing we
// most want for a fresh subdomain that needs to inherit trust from the
// main domain.
const PERSON = {
  '@type': 'Person' as const,
  name: 'Chris Hayduk',
  url: 'https://chrishayduk.com',
  sameAs: [
    'https://chrishayduk.com',
    'https://github.com/ChrisHayduk',
    'https://x.com/ChrisHayduk',
    'https://www.linkedin.com/in/chrishayduk/'
  ],
};

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Annotated Papers by Chris Hayduk',
  alternateName: 'Annotated Papers',
  url: Astro.site?.toString() ?? 'https://annotated.chrishayduk.com/',
  description:
    'Detailed annotations of research papers, with runnable code and interactive figures, by Chris Hayduk.',
  author: PERSON,
  publisher: PERSON,
  inLanguage: 'en',
};
---
<BaseLayout
  title="Annotated Papers by Chris Hayduk"
  description="Detailed walkthroughs of research papers, with runnable code and interactive figures — by Chris Hayduk."
  jsonLd={siteJsonLd}
>
  <div class="home">
    <header class="introduction">
      <p class="section-label">Annotated Papers by Chris Hayduk</p>
      <h1>Annotated Papers</h1>
      <p class="introduction-lede">
        Detailed walkthroughs of research papers, with runnable implementations and
        interactive figures alongside the original ideas.
      </p>
      <p class="introduction-note">
        Each annotation explains the notation and implementation details and includes
        interactive figures for selected mechanisms.
      </p>
    </header>

    <main class="library" aria-labelledby="library-title">
      <div class="library-heading">
        <h2 id="library-title">Featured paper</h2>
        <p>{entries.length} {entries.length === 1 ? 'annotation' : 'annotations'}</p>
      </div>

      {featured ? (
        <article class="paper-entry">
          <div class="paper-copy">
            <p class="paper-citation">
              {featured.data.authors.join(', ')} · {featured.data.venue} · {featured.data.paperYear}
            </p>
            <h3><a href={`/${featured.data.slug}`}>{featured.data.title}</a></h3>
            <p class="paper-description">{featured.data.description}</p>

            <div class="paper-links">
              <a class="primary-link" href={`/${featured.data.slug}`}>
                Read the annotation <span aria-hidden="true">→</span>
              </a>
              {featuredRepo && (
                <a
                  class="secondary-link"
                  href={featuredRepo.url}
                  target="_blank"
                  rel="noopener"
                >
                  View the implementation <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>

          <dl class="paper-details" aria-label="Annotation details">
            <div>
              <dt>Chapters</dt>
              <dd>{featured.data.chapterCount ?? 16}</dd>
            </div>
            <div>
              <dt>Code excerpts</dt>
              <dd>{featured.data.codeSnippetCount ?? 37}</dd>
            </div>
            <div>
              <dt>Interactive figures</dt>
              <dd>{featured.data.interactiveCount ?? 8}</dd>
            </div>
            <div>
              <dt>Reading time</dt>
              <dd>{featured.data.readingTimeMinutes} min</dd>
            </div>
          </dl>
        </article>
      ) : (
        <p class="empty-state">No published annotations yet.</p>
      )}
    </main>

    <section class="process" aria-labelledby="process-title">
      <div class="process-heading">
        <p class="section-label">Method</p>
        <h2 id="process-title">How the annotations work</h2>
        <p>
          Each annotation keeps the source paper, a readable implementation, and explanatory
          figures connected throughout the discussion.
        </p>
      </div>

      <ol class="process-list">
        <li>
          <span>01</span>
          <h3>Paper</h3>
          <p>Claims, equations, and architecture are explained in the order needed to follow the argument.</p>
        </li>
        <li>
          <span>02</span>
          <h3>Code</h3>
          <p>Excerpts come from runnable, tested implementations whose variable names follow the paper.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Interactive figures</h3>
          <p>Focused demonstrations make mechanisms such as attention and geometric updates easier to inspect.</p>
        </li>
      </ol>

      <p class="process-link"><a href="/about">Read more about the method <span aria-hidden="true">→</span></a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    width: min(100% - 3rem, 72rem);
    margin-inline: auto;
  }

  .introduction {
    max-width: 53rem;
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }

  .section-label {
    margin: 0 0 1rem;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .introduction h1 {
    margin: 0;
    font-size: clamp(3rem, 6vw, 4.75rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .introduction-lede {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    font-size: clamp(1.25rem, 2.3vw, 1.6rem);
    line-height: 1.45;
  }

  .introduction-note {
    max-width: 43rem;
    margin: 1.25rem 0 0;
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .library {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid var(--rule-strong);
  }

  .library-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .library-heading h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 650;
  }

  .library-heading p {
    margin: 0;
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  .paper-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    border-block: 1px solid var(--rule);
  }

  .paper-copy {
    padding: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 5vw, 4rem) clamp(2rem, 5vw, 3.5rem) 0;
  }

  .paper-citation {
    margin: 0 0 1rem;
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .paper-entry h3 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.25rem, 4.5vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .paper-entry h3 a {
    color: var(--fg);
    text-decoration: none;
  }

  .paper-entry h3 a:hover {
    color: var(--accent);
  }

  .paper-description {
    max-width: 42rem;
    margin: 1.25rem 0 0;
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    font-family: var(--font-sans);
  }

  .paper-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.8rem;
    padding: 0 1rem;
    font-size: 0.78rem;
    font-weight: 650;
    text-decoration: none;
  }

  .primary-link {
    background: var(--fg);
    color: var(--bg);
  }

  .primary-link:hover {
    background: var(--accent);
    color: var(--surface-strong);
  }

  .secondary-link {
    border: 1px solid var(--rule);
    color: var(--fg);
  }

  .secondary-link:hover {
    border-color: var(--rule-strong);
    color: var(--fg);
  }

  .paper-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: stretch;
    margin: 0;
    border-left: 1px solid var(--rule);
  }

  .paper-details div {
    display: flex;
    min-height: 8rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .paper-details div:nth-child(even) { border-right: 0; }
  .paper-details div:nth-last-child(-n + 2) { border-bottom: 0; }

  .paper-details dt {
    color: var(--fg-muted);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    line-height: 1.35;
  }

  .paper-details dd {
    margin: 0;
    font-size: 1.7rem;
    line-height: 1;
  }

  .process {
    display: grid;
    grid-template-columns: minmax(15rem, 0.65fr) 1.35fr;
    gap: clamp(3rem, 8vw, 7rem);
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    border-top: 1px solid var(--rule-strong);
  }

  .process-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .process-heading > p:last-child {
    margin: 1rem 0 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .process-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }

  .process-list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(8rem, 0.5fr) 1fr;
    gap: 1rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .process-list span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .process-list h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .process-list p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .process-link {
    grid-column: 2;
    margin: -1rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .process-link a { text-decoration: none; }

  .empty-state {
    padding-block: 3rem;
    border-block: 1px solid var(--rule);
    color: var(--fg-muted);
  }

  @media (max-width: 800px) {
    .paper-entry { grid-template-columns: 1fr; }
    .paper-copy { padding-right: 0; }
    .paper-details { border-top: 1px solid var(--rule); border-left: 0; }
    .process { grid-template-columns: 1fr; gap: 2.5rem; }
    .process-link { grid-column: 1; margin-top: -0.5rem; }
  }

  @media (max-width: 560px) {
    .home { width: min(100% - 2rem, 72rem); }
    .introduction { padding-block: 4rem; }
    .introduction h1 { font-size: 3rem; }
    .paper-entry h3 { font-size: 2.35rem; }
    .paper-links { align-items: stretch; flex-direction: column; }
    .paper-links a { justify-content: center; }
    .paper-details div { min-height: 6.5rem; padding: 1rem; }
    .process-list li { grid-template-columns: 2rem 1fr; }
    .process-list p { grid-column: 2; }
  }
</style>
